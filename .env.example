# Copy to .env and adjust. .env is never committed.

# HTTP port
PORT=3000

# production: session cookie marked Secure (requires HTTPS)
NODE_ENV=development

# Public canonical origin, no trailing slash (e.g. https://www.example.com).
# Used for canonical URLs, Open Graph, JSON-LD, robots.txt and sitemap.xml.
SITE_URL=

# Search engine indexing. Keep false everywhere except the production domain.
# Indexing is only enabled when this is true AND SITE_URL starts with https://
ALLOW_INDEXING=false

# SQLite database file (default: data/bodyfactory.db)
DB_PATH=

# First admin account. Only used when the database has no admin yet.
# If ADMIN_PASSWORD is empty, a random password is generated and written to
# data/initial-admin-password.txt (never to the console). Change it after the first login.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Set to true only behind your own reverse proxy (Nginx, Caddy) so login rate limits use
# the client IP from X-Forwarded-For.
TRUST_PROXY=false
